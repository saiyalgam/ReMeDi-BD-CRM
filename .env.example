# Supabase: Project Settings > API Keys, and the Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Long random strings you make up (for example: openssl rand -hex 32)
INGEST_TOKEN=change-me-crawler-token
CRON_SECRET=change-me-cron-secret

# Optional: your Vercel URL, used in sign-in emails (otherwise taken from the request)
NEXT_PUBLIC_SITE_URL=https://remedi-crm.vercel.app

# Local preview with sample data and no login. Never set this on Vercel.
# DEMO_MODE=1

# Google Chat and Meet: PLANNED, not part of this release. The app ignores any Chat webhook settings.

# Google Drive opportunity folders (update 4). Leave empty until an administrator has created the OAuth client.
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/google/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts the stored refresh token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes the stored token unreadable: reconnect Drive afterwards.
GOOGLE_TOKEN_ENC_KEY=
# Optional. Default is the narrow drive.file scope. Only set "drive" if the Workspace admin approved full Drive access.
# GOOGLE_DRIVE_SCOPE=drive

# DaanVeda API (server only). Put the real key in .env.local on your computer and in Vercel → Environment Variables.
# Never prefix it with NEXT_PUBLIC_ and never commit the real value.
DAANVEDA_API_KEY=
DAANVEDA_API_BASE=https://api.daanveda.com/v1

# TPIN unlock (update 6). 32+ random characters; signs the "unlocked" cookie. Set it only AFTER running supabase/update-6.sql.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to switch the PIN screen off. Changing it locks every browser (people re-enter their PIN).
PIN_COOKIE_SECRET=
